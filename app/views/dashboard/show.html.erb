<% content_for :title, "Dashboard · FXTrack" %>
<% content_for :head do %><meta name="robots" content="noindex"><% end %>

<header class="mx-auto flex max-w-content items-center justify-between gap-4 px-4 py-4 md:px-6 md:py-6">
  <%= link_to dashboard_path, class: "block w-[150px] shrink-0", aria: { label: "FXTrack dashboard" } do %>
    <%= image_tag "fxtrack-logo-dark.svg", alt: "FXTrack", width: 340, height: 110, class: "h-auto w-full" %>
  <% end %>
  <%= button_to "Log out", logout_path, method: :delete, class: "button cursor-pointer px-4 py-3" %>
</header>

<main class="mx-auto grid max-w-content gap-6 px-4 py-6 md:px-6">
  <% if notice %>
    <p role="status" class="rounded-lg border border-positive/40 bg-positive-bg/40 px-4 py-3 text-sm"><%= notice %></p>
  <% end %>

  <section class="card motion-rise">
    <h1 class="text-2xl font-bold tracking-tight">Dashboard</h1>
    <p class="mt-2 text-muted">Signed in as <strong class="text-fg"><%= Current.user.email_address %></strong>. The market dashboard arrives with M03.</p>
  </section>

  <section class="card motion-rise" style="--delay: 100ms" aria-labelledby="session-heading">
    <h2 id="session-heading" class="text-lg font-semibold">This session</h2>
    <dl class="mt-4 grid gap-4 sm:grid-cols-3">
      <div><dt class="text-sm text-muted">Expires</dt><dd class="mt-1"><%= Current.session.expires_at.in_time_zone("Pacific/Auckland").strftime("%-d %B %Y, %H:%M %Z") %></dd></div>
      <div><dt class="text-sm text-muted">Policy</dt><dd class="mt-1">7 days idle, 30 days maximum</dd></div>
      <div><dt class="text-sm text-muted">Other active devices</dt><dd class="mt-1"><%= @other_sessions %></dd></div>
    </dl>
    <% if @other_sessions.positive? %>
      <%= button_to "Sign out other devices", other_sessions_path, method: :delete, class: "button mt-6 cursor-pointer",
            form: { data: { turbo_confirm: "Sign out every other device?" } } %>
    <% end %>
  </section>
</main>
