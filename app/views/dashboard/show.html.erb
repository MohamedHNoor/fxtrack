<% content_for :title, "Dashboard · FXTrack" %>

<div data-controller="reveal">
  <header class="motion-rise mb-8 flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold tracking-tight md:text-3xl">Trading dashboard</h1>
      <p class="mt-1 text-muted">Selected pairs, market data status and your account.</p>
    </div>
    <span class="badge">Latest H1 close · <%= owner_time(@latest_close) %></span>
  </header>

  <section aria-label="Summary" class="mb-6 grid grid-cols-2 gap-3 xl:grid-cols-4">
    <% [["Account balance", @account ? nzd(@account.balance) : "Not set up", @account ? "Starting capital, cash movements and closed-trade P&L." : "Set up starting capital on the Account page.", "border-t-accent"],
        ["Active signals", @active_signals.zero? ? "None" : @active_signals.to_s, @active_signals.zero? ? "Strategies analyse each completed H1 candle." : "Review them on the Signals page.", "border-t-positive"],
        ["Enabled pairs", "#{@pairs.size} of #{ProviderRequest::SYMBOLS.size}", "Change them in Settings.", "border-t-violet"],
        ["Owner sessions", @active_sessions.to_s, "Monitoring runs while at least one is valid.", "border-t-info"]].each_with_index do |(label, value, hint, tone), index| %>
      <div class="card border-t-3 p-4 md:p-6 <%= tone %>" data-reveal-target="item" style="--delay: <%= index * 70 %>ms">
        <p class="text-sm text-muted"><%= label %></p>
        <p class="mt-2 text-xl font-bold md:text-2xl"><%= value %></p>
        <p class="mt-2 text-xs text-faint"><%= hint %></p>
      </div>
    <% end %>
  </section>

  <section class="card mb-6" aria-labelledby="watchlist-heading" data-reveal-target="item">
    <div class="mb-5 flex items-center justify-between gap-3">
      <h2 id="watchlist-heading" class="text-lg font-semibold">Watchlist</h2>
      <%= link_to "Open charts →", markets_path, class: "text-sm text-info hover:underline" %>
    </div>
    <%= render "markets/watchlist", pairs: @pairs, snapshots: @snapshots %>
  </section>

  <section class="card mb-6" aria-labelledby="journal-heading" data-reveal-target="item">
    <div class="mb-4 flex items-center justify-between gap-3">
      <h2 id="journal-heading" class="text-lg font-semibold">Recent journal</h2>
      <%= link_to "Open journal →", journal_trades_path, class: "text-sm text-info hover:underline" %>
    </div>
    <% if @recent_trades.empty? %>
      <p class="text-sm text-muted">No trades recorded yet. <%= link_to "Record a trade", new_journal_trade_path, class: "text-info hover:underline" %> when you take or skip one.</p>
    <% else %>
      <ul class="divide-y divide-line text-sm">
        <% @recent_trades.each do |trade| %>
          <li class="flex flex-wrap items-center justify-between gap-3 py-3">
            <%= link_to journal_trade_path(trade), class: "flex items-center gap-2 hover:underline" do %>
              <span><%= trade.symbol %></span> <%= direction_badge(trade.direction) %> <%= journal_state_badge(trade) %>
            <% end %>
            <span class="tabular-nums <%= change_class(trade.realized_pnl_nzd) %>">
              <%= trade.closed? ? nzd(trade.realized_pnl_nzd, signed: true) : owner_time(trade.recorded_at) %>
            </span>
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>

  <div class="grid gap-6 lg:grid-cols-2">
    <section class="card" aria-labelledby="monitoring-heading" data-reveal-target="item">
      <h2 id="monitoring-heading" class="mb-4 text-lg font-semibold">Monitoring status</h2>
      <dl class="divide-y divide-line">
        <% [["Owner sessions", "#{@active_sessions} valid"],
            ["Monitoring", @pairs.empty? ? "Paused, no pairs enabled" : (@active_sessions.positive? ? "Active while a session is valid" : "Paused, no valid session")],
            ["Provider", "Twelve Data"],
            ["Last request", @last_request ? "#{@last_request.status.humanize} · #{owner_time(@last_request.requested_at)}" : "None yet"],
            ["Market", TwelveData::MarketHours.closed?(Time.current) ? "Closed for the weekend" : "Open"]].each do |label, value| %>
          <div class="flex justify-between gap-4 py-3"><dt class="text-muted"><%= label %></dt><dd class="text-right"><%= value %></dd></div>
        <% end %>
      </dl>
    </section>

    <section class="card" aria-labelledby="session-heading" data-reveal-target="item">
      <h2 id="session-heading" class="mb-4 text-lg font-semibold">This session</h2>
      <dl class="divide-y divide-line">
        <div class="flex justify-between gap-4 py-3"><dt class="text-muted">Expires</dt><dd class="text-right"><%= owner_time(Current.session.expires_at) %></dd></div>
        <div class="flex justify-between gap-4 py-3"><dt class="text-muted">Policy</dt><dd class="text-right">7 days idle, 30 days maximum</dd></div>
        <div class="flex justify-between gap-4 py-3"><dt class="text-muted">Other active devices</dt><dd class="text-right"><%= @other_sessions %></dd></div>
      </dl>
      <% if @other_sessions.positive? %>
        <%= button_to "Sign out other devices", other_sessions_path, method: :delete, class: "button mt-4 cursor-pointer",
              form: { data: { turbo_confirm: "Sign out every other device?" } } %>
      <% end %>
    </section>
  </div>
</div>
