<% content_for :title, "Journal · FXTrack" %>
<% totals = @account.totals %>

<header class="motion-rise mb-8">
  <h1 class="text-2xl font-bold tracking-tight md:text-3xl">Trading Journal</h1>
  <p class="mt-1 text-muted">Only trades you confirm as taken affect your account balance.</p>
</header>

<section aria-label="Journal summary" class="mb-6 grid grid-cols-2 gap-3 xl:grid-cols-4">
  <% [["Account balance", nzd(@account.balance), nil],
      ["Closed-trade P&L", nzd(totals[:closed_trade_pnl], signed: true), change_class(totals[:closed_trade_pnl])],
      ["Open trades", @open_count.to_s, nil],
      ["Closed trades", @closed_count.to_s, nil]].each_with_index do |(label, value, tone), index| %>
    <div class="card motion-rise p-4 md:p-6" style="--delay: <%= 80 + index * 70 %>ms">
      <p class="text-sm text-muted"><%= label %></p>
      <p class="mt-2 text-xl font-bold tabular-nums md:text-2xl <%= tone %>"><%= value %></p>
    </div>
  <% end %>
</section>

<section class="card" aria-labelledby="history-heading">
  <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
    <h2 id="history-heading" class="text-lg font-semibold md:text-xl">Trade history</h2>
    <%= link_to "+ Record trade", new_journal_trade_path, class: "button button-primary" %>
  </div>

  <details class="disclosure mb-5 rounded-lg border border-line bg-raised/40" <%= "open" if @filters.any? %>>
    <summary class="cursor-pointer px-4 py-3 text-sm font-medium">
      Filter and export<%= " (#{@filters.size} active)" if @filters.any? %>
    </summary>
    <div class="border-t border-line p-4">
      <%= form_with url: journal_trades_path, method: :get, class: "grid gap-4 sm:grid-cols-2 lg:grid-cols-5 lg:items-end" do |form| %>
        <div>
          <%= form.label :pair, "Pair", class: "field-label" %>
          <%= form.select :pair, ProviderRequest::SYMBOLS, { include_blank: "All pairs", selected: @filters[:pair] }, class: "field-input" %>
        </div>
        <div>
          <%= form.label :state, "State", class: "field-label" %>
          <%= form.select :state, [["Open", "open"], ["Closed", "closed"], ["Skipped", "skipped"]], { include_blank: "All states", selected: @filters[:state] }, class: "field-input" %>
        </div>
        <div>
          <%= form.label :strategy, "Strategy", class: "field-label" %>
          <%= form.select :strategy, [["Manual (no signal)", "manual"]] + @strategies.map { |strategy| [strategy.name, strategy.id.to_s] },
                { include_blank: "All strategies", selected: @filters[:strategy] }, class: "field-input" %>
        </div>
        <div>
          <%= form.label :from, "From", class: "field-label" %>
          <%= form.date_field :from, value: @filters[:from], class: "field-input" %>
        </div>
        <div>
          <%= form.label :to, "To", class: "field-label" %>
          <%= form.date_field :to, value: @filters[:to], class: "field-input" %>
        </div>
        <div class="flex flex-wrap items-center gap-4 sm:col-span-2 lg:col-span-5">
          <%= form.submit "Apply filters", name: nil, class: "button cursor-pointer" %>
          <%= link_to "Clear", journal_trades_path, class: "text-sm text-info hover:underline" %>
          <%= link_to "Export CSV", journal_trades_path(format: :csv, **@filters), class: "ml-auto text-sm text-info hover:underline" %>
        </div>
      <% end %>
      <p class="mt-3 text-xs text-faint">Dates are New Zealand calendar days, matched against when a trade was opened or skipped. The export uses these filters.</p>
    </div>
  </details>

  <% if @trades.empty? %>
    <div class="rounded-lg border border-dashed border-line px-4 py-10 text-center">
      <p class="text-muted"><%= @filters.any? ? "No records match these filters." : "No journal records yet." %></p>
      <% if @filters.none? %>
        <p class="mt-1 text-sm text-faint">Record a trade when you take or skip one. Closing it posts the realized P&amp;L to your ledger.</p>
      <% end %>
    </div>
  <% else %>
    <div class="hidden overflow-x-auto md:block">
      <table class="w-full text-sm">
        <thead class="bg-raised text-left text-muted">
          <tr>
            <th scope="col" class="px-3 py-3 font-medium">Date</th><th scope="col" class="px-3 py-3 font-medium">Pair</th>
            <th scope="col" class="px-3 py-3 font-medium">Direction</th><th scope="col" class="px-3 py-3 text-right font-medium">Entry</th>
            <th scope="col" class="px-3 py-3 text-right font-medium">Exit</th><th scope="col" class="px-3 py-3 text-right font-medium">Net P&amp;L (NZD)</th>
            <th scope="col" class="px-3 py-3 font-medium">Status</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-line">
          <% @trades.each do |trade| %>
            <tr class="transition-colors hover:bg-glow/40">
              <td class="px-3 py-3 whitespace-nowrap"><time datetime="<%= trade.recorded_at.iso8601 %>" title="<%= owner_time(trade.recorded_at) %>"><%= owner_date(trade.recorded_at) %></time></td>
              <td class="px-3 py-3 font-medium whitespace-nowrap"><%= link_to trade.symbol, journal_trade_path(trade), class: "hover:text-info hover:underline", aria: { label: "#{trade.symbol} #{trade.direction} record, #{journal_summary(trade)}" } %></td>
              <td class="px-3 py-3"><%= direction_badge(trade.direction) %></td>
              <td class="px-3 py-3 text-right tabular-nums"><%= trade.entry_price ? format_price(trade.symbol, trade.entry_price) : "None" %></td>
              <td class="px-3 py-3 text-right tabular-nums"><%= trade.exit_price ? format_price(trade.symbol, trade.exit_price) : "None" %></td>
              <td class="px-3 py-3 text-right tabular-nums">
                <% if trade.closed? %>
                  <span class="<%= change_class(trade.realized_pnl_nzd) %>"><%= signed_amount(trade.realized_pnl_nzd) %></span>
                  <% if trade.pnl_source == "override" %><span class="block text-xs text-warning">Manual override</span><% end %>
                <% else %>
                  <span class="text-faint">None</span>
                <% end %>
              </td>
              <td class="px-3 py-3"><%= journal_state_badge(trade) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <ul class="grid gap-3 md:hidden" aria-label="Trade history">
      <% @trades.each do |trade| %>
        <li>
          <%= link_to journal_trade_path(trade), class: "block rounded-lg border border-line bg-raised/40 p-4 transition-colors hover:border-info" do %>
            <span class="flex items-center justify-between gap-3 border-b border-line pb-3">
              <strong><%= trade.symbol %></strong><%= direction_badge(trade.direction) %>
            </span>
            <span class="flex items-center justify-between gap-3 pt-3 text-sm">
              <span class="text-muted"><%= journal_summary(trade) %></span>
              <% if trade.closed? %>
                <strong class="tabular-nums <%= change_class(trade.realized_pnl_nzd) %>"><%= nzd(trade.realized_pnl_nzd, signed: true) %></strong>
              <% else %>
                <%= journal_state_badge(trade) %>
              <% end %>
            </span>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>
