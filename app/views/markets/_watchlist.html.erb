<%# locals: (pairs:, snapshots:) %>
<% if pairs.empty? %>
  <p class="text-muted">No currency pairs are enabled.</p>
<% else %>
  <ul class="grid gap-3 md:grid-cols-2 2xl:grid-cols-3">
    <% pairs.each_with_index do |pair, index| %>
      <% h1, h4 = snapshots.fetch(pair.symbol).values_at("1h", "4h") %>
      <li data-reveal-target="item" style="--delay: <%= index * 50 %>ms">
        <%= link_to market_path(pair), class: "block rounded-card border border-line bg-raised p-5 transition hover:-translate-y-0.5 hover:border-info" do %>
          <div class="flex items-start justify-between gap-3">
            <div>
              <h3 class="text-lg font-semibold"><%= pair.symbol %></h3>
              <p class="mt-1 text-2xl font-bold tabular-nums <%= "text-faint" unless h1.latest %>"><%= format_price(pair.symbol, h1.latest&.close) %></p>
            </div>
            <% if h1.change_percent %>
              <span class="font-semibold tabular-nums <%= change_class(h1.change) %>"><%= number_to_percentage(h1.change_percent, precision: 2, format: "%n%") %></span>
            <% end %>
          </div>
          <dl class="mt-4 grid grid-cols-2 gap-3 text-sm">
            <% [["H1", h1], ["H4", h4]].each do |label, snapshot| %>
              <div>
                <dt class="mb-1 text-muted"><%= label %></dt>
                <dd><%= state_badge(snapshot) %></dd>
              </div>
            <% end %>
          </dl>
          <% if h1.latest %>
            <p class="mt-3 text-xs text-faint">Last H1 close <%= owner_time(h1.latest.closed_at) %></p>
          <% end %>
        <% end %>
      </li>
    <% end %>
  </ul>
<% end %>
