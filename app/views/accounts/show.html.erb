<% content_for :title, "Account · FXTrack" %>

<header class="motion-rise mb-8">
  <%= link_to "← Settings", settings_path, class: "text-sm text-info hover:underline" %>
  <h1 class="mt-2 text-2xl font-bold tracking-tight md:text-3xl">Account ledger</h1>
  <p class="mt-1 text-muted">Capital and cash movements in NZD. Entries are permanent; corrections use reversals.</p>
</header>

<% if alert %><p role="alert" class="mb-6 rounded-lg border border-negative/50 bg-negative-bg/40 px-4 py-3 text-sm"><%= alert %></p><% end %>

<% if @account.nil? || @account.new_record? %>
  <section class="card max-w-xl" aria-labelledby="setup-heading">
    <h2 id="setup-heading" class="text-lg font-semibold">Set up your NZD account</h2>
    <p class="mt-2 mb-6 text-sm text-muted">Starting capital is fixed once saved. Record later changes as deposits, withdrawals or adjustments.</p>
    <%= render "accounts/errors", record: @account if @account %>
    <%= form_with model: @account || TradingAccount.new, url: account_path, class: "grid gap-5" do |form| %>
      <div>
        <%= form.label :starting_capital, "Starting capital (NZD)", class: "field-label" %>
        <%= form.number_field :starting_capital, step: "0.01", min: 0, required: true, class: "field-input" %>
      </div>
      <div>
        <%= form.label :started_at, "Start date", class: "field-label" %>
        <%= form.datetime_local_field :started_at, value: (form.object.started_at || Time.current).in_time_zone(MarketsHelper::OWNER_TIME_ZONE).strftime("%Y-%m-%dT%H:%M"), required: true, class: "field-input" %>
      </div>
      <%= form.submit "Set up account", class: "button button-primary cursor-pointer" %>
    <% end %>
  </section>
<% else %>
  <% totals = @account.totals %>
  <div class="grid gap-6 lg:grid-cols-[1fr_1.2fr]">
    <section class="card motion-rise" aria-labelledby="balance-heading">
      <h2 id="balance-heading" class="text-sm text-muted">Current balance</h2>
      <p class="mt-2 text-3xl font-bold tabular-nums"><%= nzd(@account.balance) %></p>
      <dl class="mt-6 divide-y divide-line">
        <% [["Starting capital", nzd(@account.starting_capital)], ["Deposits", nzd(totals[:deposits])], ["Withdrawals", nzd(totals[:withdrawals])],
            ["Adjustments and reversals", nzd(totals[:adjustments], signed: true)], ["Closed trade P&L", "Arrives with the journal"],
            ["Unrealized P&L", "Not included"]].each do |label, value| %>
          <div class="flex justify-between gap-4 py-3 text-sm"><dt class="text-muted"><%= label %></dt><dd class="text-right tabular-nums"><%= value %></dd></div>
        <% end %>
      </dl>
    </section>

    <section class="card motion-rise" style="--delay: 100ms" aria-labelledby="entry-heading">
      <h2 id="entry-heading" class="mb-4 text-lg font-semibold">Record a movement</h2>
      <%= render "accounts/errors", record: @entry %>
      <%= form_with model: @entry, url: ledger_entries_path, class: "grid gap-4 sm:grid-cols-2" do |form| %>
        <div>
          <%= form.label :kind, "Type", class: "field-label" %>
          <%= form.select :kind, [["Deposit", "deposit"], ["Withdrawal", "withdrawal"], ["Adjustment", "adjustment"]], {}, class: "field-input" %>
        </div>
        <div>
          <%= form.label :amount, "Amount (NZD)", class: "field-label" %>
          <%= form.number_field :amount, value: @entry.amount&.abs, step: "0.01", min: "0.01", required: true, class: "field-input" %>
        </div>
        <fieldset class="sm:col-span-2">
          <legend class="field-label">Adjustment direction</legend>
          <div class="flex gap-6 text-sm">
            <label class="flex items-center gap-2"><%= radio_button_tag "account_ledger_entry[direction]", "increase", params.dig(:account_ledger_entry, :direction) != "decrease", class: "accent-accent" %> Increase balance</label>
            <label class="flex items-center gap-2"><%= radio_button_tag "account_ledger_entry[direction]", "decrease", params.dig(:account_ledger_entry, :direction) == "decrease", class: "accent-accent" %> Decrease balance</label>
          </div>
          <p class="mt-1 text-xs text-faint">Only used for adjustments.</p>
        </fieldset>
        <div>
          <%= form.label :effective_at, "Effective", class: "field-label" %>
          <%= form.datetime_local_field :effective_at, value: (@entry.effective_at || Time.current).in_time_zone(MarketsHelper::OWNER_TIME_ZONE).strftime("%Y-%m-%dT%H:%M"), class: "field-input" %>
        </div>
        <div>
          <%= form.label :notes, class: "field-label" %>
          <%= form.text_field :notes, maxlength: 500, class: "field-input" %>
        </div>
        <%= form.submit "Record", class: "button button-primary cursor-pointer sm:col-span-2" %>
      <% end %>
    </section>
  </div>

  <section class="card mt-6" aria-labelledby="ledger-heading">
    <h2 id="ledger-heading" class="mb-4 text-lg font-semibold">Ledger</h2>
    <% entries = @account.ledger_entries.includes(:reversal).reverse %>
    <% if entries.empty? %>
      <p class="text-sm text-muted">No movements recorded since the account started on <%= owner_time(@account.started_at) %>.</p>
    <% else %>
      <div class="overflow-x-auto">
        <table class="w-full min-w-[640px] text-sm">
          <thead class="bg-raised text-left text-muted">
            <tr><th class="px-3 py-3 font-medium">Effective</th><th class="px-3 py-3 font-medium">Type</th><th class="px-3 py-3 text-right font-medium">Amount</th><th class="px-3 py-3 font-medium">Notes</th><th class="px-3 py-3"><span class="sr-only">Actions</span></th></tr>
          </thead>
          <tbody class="divide-y divide-line">
            <% entries.each do |entry| %>
              <tr class="<%= "text-faint" if entry.reversal %>">
                <td class="px-3 py-3 whitespace-nowrap"><%= owner_time(entry.effective_at) %></td>
                <td class="px-3 py-3"><%= entry.kind.capitalize %><%= " (reversed)" if entry.reversal %></td>
                <td class="px-3 py-3 text-right tabular-nums <%= entry.amount.positive? ? "text-positive" : "text-negative" %>"><%= nzd(entry.amount, signed: true) %></td>
                <td class="px-3 py-3 text-muted"><%= entry.notes %></td>
                <td class="px-3 py-3 text-right">
                  <% if entry.reversible? %>
                    <%= button_to "Reverse", ledger_entry_reversal_path(entry), class: "text-info hover:underline cursor-pointer",
                          form: { data: { turbo_confirm: "Record a reversal of this #{entry.kind}?" } } %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </section>
<% end %>
