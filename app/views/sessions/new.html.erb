<% content_for :title, "Owner login · FXTrack" %>
<% content_for :head do %><meta name="robots" content="noindex"><% end %>

<%= render "shared/public_header" %>

<main class="mx-auto max-w-md px-6 py-16">
  <section class="rounded-3xl bg-white p-10 text-center text-auth-fg shadow-2xl shadow-black/40">
    <%= image_tag "fxtrack-logo.svg", alt: "FXTrack", width: 340, height: 110, class: "mx-auto mb-6 h-auto w-[185px]" %>
    <h1 class="mb-3 text-2xl font-bold">Owner login</h1>
    <p class="text-auth-muted">Owner sign-in is not available yet. It arrives with owner authentication.</p>
    <%= link_to "Back to home", root_path, class: "button mt-8 w-full border-auth-line bg-white text-auth-fg" %>
  </section>
</main>
