<!DOCTYPE html>
<html lang="en">
  <head>
    <% title = content_for(:title) || "FXTrack" %>
    <% description = content_for(:description) || "FXTrack is a private forex decision-support workspace for one owner." %>
    <title><%= title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= description %>">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="FXTrack">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#061525">
    <link rel="canonical" href="<%= request.base_url + request.path %>">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="FXTrack">
    <meta property="og:title" content="<%= title %>">
    <meta property="og:description" content="<%= description %>">
    <meta property="og:url" content="<%= request.base_url + request.path %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="<%= image_path("fxtrack-favicon.svg") %>" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-[radial-gradient(ellipse_at_top_right,var(--color-glow),var(--color-canvas)_65%)]">
    <%= content_for?(:app_body) ? yield(:app_body) : yield %>
  </body>
</html>
